<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- App Logo with Rounded Corners -->
    <ImageView
        android:id="@+id/aboutLogo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <!-- App Name & Version -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="v1.0.0"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Author Badge: Engineered by Muhammad Haris Zubair -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/aboutAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engineered by Muhammad Haris Zubair"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/about_desc"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- GitHub Link Button -->
    <TextView
        android:id="@+id/aboutGithubLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        android:text="github.com/haris-ui/yotobe"
        android:textColor="@color/accent_blue"
        android:textSize="12sp" />

    <!-- Close Button -->
    <Button
        android:id="@+id/aboutBtnClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_btn_accent"
        android:stateListAnimator="@null"
        android:text="@string/btn_close"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
